{
	"name": "@cheatbreaker/skinview3d",
	"version": "1.0.2",
	"description": "Three.js powered Minecraft skin viewer",
	"main": "libs/skinview3d.js",
	"type": "module",
	"scripts": {
		"clean": "rimraf libs bundles",
		"build:modules": "tsc -p .",
		"build:bundles": "rollup -c --configPlugin=swc3",
		"build:docs": "typedoc src/viewer.ts",
		"build:preview": "vite build",
		"build": "pnpm build:modules && pnpm build:bundles && pnpm build:preview",
		"format": "prettier src examples eslint.config.js --write",
		"test:lint": "eslint src examples eslint.config.js",
		"test": "pnpm test:lint",
		"dev:watch:modules": "tsc -w --preserveWatchOutput --declaration --sourceMap --outDir libs -p .",
		"dev:watch:bundles": "rollup -w --no-watch.clearScreen -c --configPlugin=swc3",
		"dev": "vite",
		"preview": "vite preview",
		"prepublishOnly": "pnpm clean && pnpm build",
		"prepare": "pnpm build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cheatbreakernet/skinview3d.git"
	},
	"bugs": {
		"url": "https://github.com/cheatbreakernet/skinview3d/issues"
	},
	"homepage": "https://github.com/cheatbreakernet/skinview3d",
	"files": [
		"libs",
		"bundles",
		"assets"
	],
	"dependencies": {
		"@types/three": "^0.185.4",
		"molang": "^2.0.1",
		"skinview-utils": "^0.7.1",
		"three": "^0.185.1"
	},
	"devDependencies": {
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@swc/core": "^1.16.0",
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.67.0",
		"@yushijinhun/three-minifier-rollup": "^0.4.0",
		"eslint": "^10.8.1",
		"eslint-plugin-tsdoc": "^0.5.2",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"rollup": "^4.52.4",
		"rollup-plugin-swc3": "^0.12.1",
		"typedoc": "^0.28.20",
		"typescript": "^6.0.3",
		"vite": "^8.2.1"
	}
}